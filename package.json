{
  "name": "multiplayer-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Комнаты и серверная валидация для сетевых игр на Cloudflare Durable Objects и WebSocket; демо: морской бой со скрытой информацией",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "serve": "node scripts/dev-server.mjs",
    "e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
